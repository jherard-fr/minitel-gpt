# Fournisseur d'IA : "mistral" (defaut), "claude" ou "linkup"
LLM_PROVIDER=mistral

# Mistral
MISTRAL_KEY=...
MISTRAL_MODEL=mistral-small-latest

# Claude (Anthropic) - utilise si LLM_PROVIDER=claude
ANTHROPIC_KEY=...
CLAUDE_MODEL=claude-haiku-4-5

# Linkup (recherche web) - utilise si LLM_PROVIDER=linkup
# ATTENTION : Linkup n'est pas un generateur de texte mais un moteur de
# recherche web. Le prompt systeme (personnalite) et l'historique de
# conversation ne s'appliquent pas dans ce mode.
LINKUP_KEY=...
LINKUP_DEPTH=standard
